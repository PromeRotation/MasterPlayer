<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>MasterPlayer.MechanicRuntime</AssemblyName>
    <RootNamespace>BossMod</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Upstream\**\*.cs" />
    <Compile Include="Hosting\**\*.cs" />
    <Using Include="System" />
    <Using Include="System.Collections" />
    <Using Include="System.Collections.Concurrent" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.Collections.Immutable" />
    <Using Include="System.Runtime.InteropServices" />
    <Using Include="System.Runtime.CompilerServices" />
    <Using Include="System.Linq" />
    <Using Include="System.Numerics" />
    <Using Include="System.Threading.Tasks" />
    <Using Include="System.Text" />
    <Reference Include="Dalamud" HintPath="$(DalamudRoot)\Dalamud.dll" Private="false" />
    <Reference Include="Dalamud.Common" HintPath="$(DalamudRoot)\Dalamud.Common.dll" Private="false" />
    <Reference Include="Dalamud.Bindings.ImGui" HintPath="$(DalamudRoot)\Dalamud.Bindings.ImGui.dll" Private="false" />
    <Reference Include="Dalamud.Bindings.ImPlot" HintPath="$(DalamudRoot)\Dalamud.Bindings.ImPlot.dll" Private="false" />
    <Reference Include="ImGuiScene" HintPath="$(DalamudRoot)\ImGuiScene.dll" Private="false" />
    <Reference Include="FFXIVClientStructs" HintPath="$(DalamudRoot)\FFXIVClientStructs.dll" Private="false" />
    <Reference Include="InteropGenerator.Runtime" HintPath="$(DalamudRoot)\InteropGenerator.Runtime.dll" Private="false" />
    <Reference Include="Lumina" HintPath="$(DalamudRoot)\Lumina.dll" Private="false" />
    <Reference Include="Lumina.Excel" HintPath="$(DalamudRoot)\Lumina.Excel.dll" Private="false" />
    <PackageReference Include="TerraFX.Interop.Windows" Version="10.0.26100.6" />
    <EmbeddedResource Include="Upstream\Pathfinding\ObstacleMaps\*">
      <LogicalName>BossModReborn.Pathfinding.ObstacleMaps.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
