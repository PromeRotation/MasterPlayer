<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblyName>MasterPlayer</AssemblyName>
    <RootNamespace>MasterPlayer</RootNamespace>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;MechanicRuntime\**;LocalOnly\**;analysis\**</DefaultItemExcludes>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' Or '$(Configuration)' == 'Release' ">
    <OutputPath>$(XIVLauncherRoot)\pluginConfigs\PromeRotation\Plugins\MasterPlayer</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(CI)' == 'true' ">
    <OutputPath>$(MSBuildProjectDirectory)\bin\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DotRecast.Recast" Version="2026.3.1" />
    <EmbeddedResource Include="src\UI\WorldDrawing\DrawPlus.hlsl" LogicalName="MasterPlayer.Drawing.DrawPlus.hlsl" />
    <ProjectReference Include="MechanicRuntime\MasterPlayer.MechanicRuntime.csproj" />
    <None Update="ThirdPartyNotices\BossModReborn.LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Update="ThirdPartyNotices\PromeRotation.LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Update="ThirdPartyNotices\DotRecast.LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Update="ThirdPartyNotices\PromeDrawPlus.NOTICE" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(UsePromeRotationSdk)' == 'true'">
    <PackageReference Include="PromeRotation.SDK.CNGL" Version="[$(PromeRotationSdkVersion)]" GeneratePathProperty="true" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.13.0" ExcludeAssets="runtime;analyzers" />
    <PackageReference Include="TerraFX.Interop.Windows" Version="10.0.26100.6" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup Condition="'$(UsePromeRotationSdk)' != 'true'">
    <Reference Include="TerraFX.Interop.Windows">
      <HintPath>$(DalamudRoot)\TerraFX.Interop.Windows.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Dalamud">
      <HintPath>$(DalamudRoot)\Dalamud.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Dalamud.Bindings.ImGui">
      <HintPath>$(DalamudRoot)\Dalamud.Bindings.ImGui.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ECommons">
      <HintPath>$(PromeRotationPath)\ECommons.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="FFXIVClientStructs">
      <HintPath>$(DalamudRoot)\FFXIVClientStructs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="InteropGenerator.Runtime">
      <HintPath>$(DalamudRoot)\InteropGenerator.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Lumina">
      <HintPath>$(DalamudRoot)\Lumina.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Lumina.Excel">
      <HintPath>$(DalamudRoot)\Lumina.Excel.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis">
      <HintPath>$(PromeRotationPath)\Microsoft.CodeAnalysis.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp">
      <HintPath>$(PromeRotationPath)\Microsoft.CodeAnalysis.CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PromeRotation">
      <HintPath>$(PromeRotationPath)\PromeRotation.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PromeRotation.Scripting">
      <HintPath>$(PromeRotationPath)\PromeRotation.Scripting.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="GeneratePluginBuildVersion" BeforeTargets="CoreCompile" DependsOnTargets="GetAssemblyVersion">
    <WriteLinesToFile File="$(IntermediateOutputPath)PluginBuildVersion.g.cs"
                      Lines="namespace MasterPlayer%3B internal static class PluginBuildVersion { public const string Value = &quot;$(AssemblyVersion)&quot;%3B }"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)PluginBuildVersion.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)PluginBuildVersion.g.cs" />
    </ItemGroup>
  </Target>

  <!-- PR 子插件需要 PromeRotation.Scripting.dll 在插件目录（PR 加载器在该目录解析子插件依赖） -->
  <Target Name="CopyPromeRotationScripting" AfterTargets="Build" Condition="'$(UsePromeRotationSdk)' != 'true'">
    <Copy SourceFiles="$(PromeRotationPath)\PromeRotation.Scripting.dll"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyTerrainDependencies" AfterTargets="Build">
    <Copy SourceFiles="@(ReferencePath)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true"
          Condition="'%(ReferencePath.Filename)' == 'DotRecast.Core' Or '%(ReferencePath.Filename)' == 'DotRecast.Recast'" />
  </Target>

</Project>
