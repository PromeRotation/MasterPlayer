<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefaultItemExcludes>$(DefaultItemExcludes);ScriptCompilation\**;MechanicRuntime\**;UiCompatibility\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MechanicRuntime\MasterPlayer.MechanicRuntime.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\src\Spatial\**\*.cs" Link="Spatial\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\src\UI\Radar\HostDrawingGeometry.cs" Link="HostDrawingGeometry.cs" />
    <None Update="Fixtures\Crucible\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures\Blunderville\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="..\src\Core\Settings\SafeZoneActivation.cs" Link="SafeZoneActivation.cs" />
    <Compile Include="..\src\Core\Settings\AoeViewSettings.cs" Link="AoeViewSettings.cs" />
    <Compile Include="..\src\Core\Settings\MasterPlayerSettings.cs" Link="MasterPlayerSettings.cs" />
    <Compile Include="..\src\Movement\Follow\FollowController.cs" Link="FollowController.cs" />
    <Compile Include="..\src\Movement\Follow\DangerAwareFollowGoalTemplate.cs" Link="DangerAwareFollowGoalTemplate.cs" />
    <Compile Include="..\src\Movement\Follow\OptionalGoalSafety.cs" Link="OptionalGoalSafety.cs" />
    <Compile Include="..\src\UI\Radar\RadarProjection.cs" Link="RadarProjection.cs" />
    <Compile Include="..\src\UI\Radar\RadarPathDashes.cs" Link="RadarPathDashes.cs" />
    <Compile Include="..\src\UI\Radar\RadarArenaLayout.cs" Link="RadarArenaLayout.cs" />
    <Compile Include="..\src\UI\Radar\RadarLocalGeometry.cs" Link="RadarLocalGeometry.cs" />
    <Compile Include="..\src\UI\Radar\RadarClipRegion.cs" Link="RadarClipRegion.cs" />
    <Compile Include="..\src\UI\Radar\AoeVisibilityRegistry.cs" Link="AoeVisibilityRegistry.cs" />
    <Compile Include="..\src\Mechanics\Host\MechanicDrawConvert.cs" Link="MechanicHost\MechanicDrawConvert.cs" />
    <Compile Include="..\src\Mechanics\Host\MechanicHintsConvert.cs" Link="MechanicHost\MechanicHintsConvert.cs" />
    <Compile Include="..\src\Mechanics\Host\MechanicTimelineView.cs" Link="MechanicHost\MechanicTimelineView.cs" />
    <Compile Include="..\src\Mechanics\Host\MechanicEventFactory.cs" Link="MechanicHost\MechanicEventFactory.cs" />
    <Compile Include="..\src\Mechanics\Host\ReplayFeedAdapter.cs" Link="MechanicHost\ReplayFeedAdapter.cs" />
    <Compile Include="..\src\Movement\Dodge\AoeShapeDatabase.cs" Link="AoeShapeDatabase.cs" />
    <Compile Include="..\src\Movement\Dodge\DangerMarginInflator.cs" Link="DangerMarginInflator.cs" />
    <Compile Include="..\src\Scripting\CastRotation.cs" Link="CastRotation.cs" />
    <Compile Include="..\src\Scripting\Visual\*.cs" Link="Visual\%(Filename)%(Extension)" />
    <Compile Include="..\src\Scripting\ScriptMoveApi.cs" Link="ScriptMoveApi.cs" />
    <Compile Include="..\src\Scripting\ScriptHintsApi.cs" Link="ScriptHintsApi.cs" />
    <Compile Include="..\src\Mechanics\Host\MechanicFacingControl.cs" Link="MechanicHost\MechanicFacingControl.cs" />
    <Compile Include="..\src\Scripting\IScriptEventRouter.cs" Link="IScriptEventRouter.cs" />
    <Compile Include="..\src\Replay\ReplayRecording.cs" Link="Replay\ReplayRecording.cs" />
    <Compile Include="..\src\Replay\ReplayWorldState.cs" Link="Replay\ReplayWorldState.cs" />
    <Compile Include="..\src\Replay\ReplayPlayback.cs" Link="Replay\ReplayPlayback.cs" />
    <Compile Include="..\src\Replay\ReplayRecordFilter.cs" Link="Replay\ReplayRecordFilter.cs" />
    <Compile Include="..\src\Replay\ReplayScriptEventRouter.cs" Link="Replay\ReplayScriptEventRouter.cs" />
    <Compile Include="..\src\Replay\ReplayTimeline.cs" Link="Replay\ReplayTimeline.cs" />
    <Compile Include="..\src\Replay\ReplayComparison.cs" Link="Replay\ReplayComparison.cs" />

    <Compile Include="..\Presets\Crucible\**\*.cs" Exclude="..\Presets\Crucible\CrucibleScript.cs;..\Presets\Crucible\Entries\**" Link="Crucible\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Presets\Dungeons\**\*.cs" Exclude="..\Presets\Dungeons\DungeonScript.cs;..\Presets\Dungeons\Entries\**" Link="Dungeons\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Presets\Blunderville\**\*.cs" Exclude="..\Presets\Blunderville\BlundervilleScript.cs;..\Presets\Blunderville\BlundervilleNativeControl.cs;..\Presets\Blunderville\Entries\**" Link="Blunderville\%(RecursiveDir)%(Filename)%(Extension)" />
    <Reference Include="PromeRotation" HintPath="$(PromeRotationPath)\PromeRotation.dll" />
    <Reference Include="ECommons" HintPath="$(PromeRotationPath)\ECommons.dll" />
    <Reference Include="Dalamud" HintPath="$(DalamudRoot)\Dalamud.dll" />
    <Reference Include="FFXIVClientStructs" HintPath="$(DalamudRoot)\FFXIVClientStructs.dll" />
    <Reference Include="InteropGenerator.Runtime" HintPath="$(DalamudRoot)\InteropGenerator.Runtime.dll" />
    <Reference Include="Lumina" HintPath="$(DalamudRoot)\Lumina.dll" />
    <Reference Include="Lumina.Excel" HintPath="$(DalamudRoot)\Lumina.Excel.dll" />
  </ItemGroup>
</Project>
