<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PromeRotationRoot Condition="'$(PromeRotationRoot)' == ''">C:\Users\xiaos\Documents\GitHub\PromeRotation-1.0-XSZFork\</PromeRotationRoot>
    <DalamudRoot>$(APPDATA)\XIVLauncherCN\addon\Hooks\dev\</DalamudRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="ScriptCatalogRegression.cs" />
    <Reference Include="Microsoft.CodeAnalysis" HintPath="$(PromeRotationRoot)PromeRotation/bin/Debug/Microsoft.CodeAnalysis.dll" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(PromeRotationRoot)PromeRotation/bin/Debug/Microsoft.CodeAnalysis.CSharp.dll" />
    <Reference Include="PromeRotation" HintPath="$(PromeRotationRoot)PromeRotation/bin/Debug/PromeRotation.dll" />
    <Reference Include="PromeRotation.Scripting" HintPath="$(PromeRotationRoot)PromeRotation/bin/Debug/PromeRotation.Scripting.dll" />
    <Reference Include="ECommons" HintPath="$(PromeRotationRoot)PromeRotation/bin/Debug/ECommons.dll" />
    <Reference Include="Dalamud" HintPath="$(DalamudRoot)Dalamud.dll" />
    <Reference Include="Dalamud.Bindings.ImGui" HintPath="$(DalamudRoot)Dalamud.Bindings.ImGui.dll" />
    <Reference Include="FFXIVClientStructs" HintPath="$(DalamudRoot)FFXIVClientStructs.dll" />
    <Reference Include="InteropGenerator.Runtime" HintPath="$(DalamudRoot)InteropGenerator.Runtime.dll" />
    <Reference Include="Lumina" HintPath="$(DalamudRoot)Lumina.dll" />
    <Reference Include="Lumina.Excel" HintPath="$(DalamudRoot)Lumina.Excel.dll" />
  </ItemGroup>
</Project>
